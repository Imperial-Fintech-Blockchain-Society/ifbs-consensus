SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Prisma uses Postgres directly. Supabase URL/key are optional for this app.
# Use a Supabase session-pooler URL (port 5432) for the app and migrations.
VERCEL_DB_URL=
# At least 32 random characters.
JWT_SECRET=
COINGECKO_API_URL=https://api.coingecko.com/api/v3
# Optional CoinGecko Demo API key (sent as x-cg-demo-api-key).
COINGECKO_API_KEY=

# Email provider (required for signup confirmation and weekly digests)
# Use a full-access key for contact, segment, and broadcast APIs.
RESEND_API_KEY=
EMAIL_FROM=IFBS Consensus <noreply@your-verified-domain.com>
# Optional dedicated app-managed digest segment. Created automatically if unset.
RESEND_DIGEST_SEGMENT_ID=

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron-job protection
CRON_SECRET=
